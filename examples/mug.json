{
  "timeline": { "start": 1, "end": 1, "fps": 24 },
  "parameters": {
    "radius": 4,
    "height": 9,
    "wall": 0.4,
    "bottom": 0.6,
    "handle_size": 2.6,
    "handle_thick": 0.55
  },
  "nodes": {
    "body_profile": {
      "type": "curve",
      "params": {
        "points": [
          [0, 0, 0],
          ["radius - 0.3", 0, 0],
          ["radius", 0.4, 0],
          ["radius", "height", 0],
          ["radius - wall", "height", 0],
          ["radius - wall", "bottom", 0],
          [0, "bottom", 0]
        ],
        "smooth": "catmull",
        "resolution": 6,
        "sharp": [1, 3, 4, 5]
      }
    },
    "body": { "type": "revolve", "inputs": ["body_profile"], "params": { "divisions": 64 } },
    "handle_section": { "type": "circle", "params": { "radius": "handle_thick", "segments": 16, "plane": "xz", "output": "polyline", "center": ["handle_size", 0, 0] } },
    "handle_ring": { "type": "revolve", "inputs": ["handle_section"], "params": { "axis": [0, 0, 1], "start_angle": -90, "end_angle": 90, "divisions": 24 } },
    "handle": { "type": "transform", "inputs": ["handle_ring"], "params": { "translate": ["radius - 0.2", "height * 0.5", 0] } },
    "mug": { "type": "merge", "inputs": ["body", "handle"] }
  },
  "output": "mug"
}
